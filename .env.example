# Copy to .env.local and fill in. Placeholders only — never commit real values.
# Every variable here is read by the code (api/ or src/); see README "Environment Setup".

# ── AI chat: at least one provider key. Unconfigured providers are skipped. ──
LLM_CHAIN=anthropic,gemini,huggingface
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HUGGINGFACE_API_KEY=
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
LLM_TIMEOUT_MS=8000

# ── /api/fit ──
FIT_RATE_LIMIT_MAX=3
FIT_RATE_LIMIT_WINDOW_MS=600000
FIT_PROVIDER_TIMEOUT_MS=18000

# ── Chat rate limit ──
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_MS=60000

# ── Durable rate limiting (Upstash; the KV_REST_API_* names also work) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# …or, if the Vercel KV integration injects them, these names instead:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── CORS ──
ALLOWED_ORIGIN=
VERCEL_PREVIEW_PREFIX=my-portfolio

# ── GitHub activity proxy ──
GITHUB_TOKEN=
GITHUB_USERNAME=hasnainrazaa03

# ── Analytics (Supabase, server-only) ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ANALYTICS_SECRET_TOKEN=
ANALYTICS_IP_SALT=

# ── Error tracking ──
SENTRY_DSN=
VITE_SENTRY_DSN=

# ── Contact form (EmailJS; public by design) ──
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

